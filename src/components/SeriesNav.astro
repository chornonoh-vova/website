---
import { seriesParts } from "../lib/posts";
import Link from "./Link.astro";

interface Props {
  name: string;
  current: string;
}

const { name, current }: Props = Astro.props;

const parts = await seriesParts(name);
const currentPart = parts.find((part) => part.id === current)?.data.series?.part;
---

<nav
  class="not-prose my-8 rounded-sm border border-neutral-200 p-4 text-sm dark:border-neutral-700"
  aria-label={`${name} series`}
>
  <p class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <span class="font-medium">{name}</span>
    {
      currentPart !== undefined && (
        <span class="text-black/60 dark:text-white/60">
          Part {currentPart} of {parts.length}
        </span>
      )
    }
  </p>

  <ol class="list-none space-y-1.5 ps-0">
    {
      parts.map((part) => {
        const label = part.data.series?.label ?? part.data.title;
        const number = part.data.series?.part;

        if (part.data.draft) {
          return (
            <li class="text-black/50 dark:text-white/50">
              {number}. {label}{" "}
              <span class="italic">(not published yet)</span>
            </li>
          );
        }

        if (part.id === current) {
          return (
            <li class="font-medium" aria-current="page">
              {number}. {label}{" "}
              <span class="font-normal text-black/60 dark:text-white/60">
                (you are here)
              </span>
            </li>
          );
        }

        return (
          <li>
            {number}.{" "}
            <Link href={`/blog/${part.id}/`} underline>
              {label}
            </Link>
          </li>
        );
      })
    }
  </ol>
</nav>
