---
import { seriesParts } from "../lib/posts";
import Link from "./Link.astro";

interface Props {
  name: string;
  current: string;
}

const { name, current }: Props = Astro.props;

const parts = await seriesParts(name);
const currentPart = parts.find((part) => part.id === current)?.data.series?.part;
---

<nav
  class="not-prose my-8 rounded-sm border border-neutral-200 p-4 text-sm dark:border-neutral-700"
  aria-label={`${name} series`}
>
  <p class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <span class="font-medium">{name}</span>
    {
      currentPart !== undefined && (
        <span class="opacity-60">
          Part {currentPart} of {parts.length}
        </span>
      )
    }
  </p>

  <ol class="list-none space-y-1.5 ps-0">
    {
      parts.map((part) => {
        const series = part.data.series!;
        const label = series.label ?? part.data.title;
        const isCurrent = part.id === current;

        return (
          <li
            class:list={[part.data.draft && "opacity-50", isCurrent && "font-medium"]}
            aria-current={isCurrent ? "page" : undefined}
          >
            {series.part}.{" "}
            {part.data.draft || isCurrent ? (
              label
            ) : (
              <Link href={`/blog/${part.id}/`} underline>
                {label}
              </Link>
            )}
            {part.data.draft && <span class="italic"> (not published yet)</span>}
            {isCurrent && <span class="font-normal opacity-60"> (you are here)</span>}
          </li>
        );
      })
    }
  </ol>
</nav>
